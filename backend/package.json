{
  "name": "pharmawork-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/apps/api-gateway/src/main.js",
    "start:dev": "concurrently -k -n employee,attendance,gateway \"npm:start:dev:employee\" \"npm:start:dev:attendance\" \"npm:start:dev:gateway\"",
    "start:dev:gateway": "nest start gateway --watch",
    "start:dev:employee": "nest start employee --watch",
    "start:dev:attendance": "nest start attendance --watch",
    "start:prod": "concurrently -k -n employee,attendance,gateway \"node dist/apps/employee-service/src/main.js\" \"node dist/apps/attendance-service/src/main.js\" \"node dist/apps/api-gateway/src/main.js\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "lint": "oxlint apps/ libs/ prisma/ tests/",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"prisma/**/*.ts\"",
    "db:start:local": "powershell -NoProfile -File infra/start-local-mysql.ps1"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/microservices": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.10",
    "exifr": "7.1.3",
    "multer": "2.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "12.5.0",
    "@types/express": "^5.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "10.0.7",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "mysql"
}

enum Role {
    EMPLOYEE
    HRD
}

enum DepartmentCode {
    SALES
    MARKETING
    PRODUCTION
    FINANCE
    HR
    IT
    R_AND_D
    LOGISTIC
    ADMINISTRATION_AND_SECRETARY
    DESIGN_DEPARTMENT
}

enum AttendanceSource {
    DIRECT
    MISSED_CHECK_IN_CLAIM
}

enum CheckoutType {
    MANUAL
    AUTO
}

enum AttendanceEvidenceKind {
    CHECKIN_WORK_PROOF
    CHECKIN_SELFIE
    CHECKOUT_WORK_PROOF
    CHECKOUT_SELFIE
}

enum WorkProofType {
    SCREEN
    WORKSPACE
}

enum MissedCheckInClaimStatus {
    PENDING
    APPROVED
    REJECTED
}

model User {
    id                  String                        @id @default(uuid()) @db.Char(36)
    email               String                        @unique @db.VarChar(191)
    passwordHash        String                        @db.VarChar(255)
    role                Role                          @default(EMPLOYEE)
    active              Boolean                       @default(true)
    employee            Employee?
    sessions            Session[]
    activationToken     ActivationToken?
    missedCheckInReviewGrants MissedCheckInReviewGrant[]
    reviewedMissedCheckInClaims MissedCheckInClaim[] @relation("MissedCheckInReviewer")
    createdAt           DateTime                      @default(now())
}

model ActivationToken {
    id        String    @id @default(uuid()) @db.Char(36)
    userId    String    @unique @db.Char(36)
    user      User      @relation(fields: [userId], references: [id])
    tokenHash String    @unique @db.Char(64)
    expiresAt DateTime
    usedAt    DateTime?
    createdAt DateTime  @default(now())
}

model Session {
    id        String   @id @db.Char(36)
    userId    String   @db.Char(36)
    user      User     @relation(fields: [userId], references: [id])
    expiresAt DateTime
    revoked   Boolean  @default(false)

    @@index([userId])
}

model EmployeeNumberSequence {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
}

model Employee {
    id                 String                        @id @default(uuid()) @db.Char(36)
    userId             String                        @unique @db.Char(36)
    user               User                          @relation(fields: [userId], references: [id])
    employeeNumber     String                        @unique @db.VarChar(50)
    fullName           String                        @db.VarChar(150)
    department         DepartmentCode
    position           String                        @db.VarChar(100)
    active             Boolean                       @default(true)
    createdAt          DateTime                      @default(now())
    updatedAt          DateTime                      @updatedAt
    attendances        Attendance[]
    missedCheckInClaims MissedCheckInClaim[]

    @@index([active, createdAt])
}

model Attendance {
    id                  String                       @id @default(uuid()) @db.Char(36)
    employeeId          String                       @db.Char(36)
    employee            Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
    employeeName        String                       @db.VarChar(150)
    employeeNumber      String                       @db.VarChar(50)
    department          DepartmentCode
    submittedAt         DateTime                     @db.DateTime(3)
    workDate            String                       @db.Char(10)
    latitude            Float?
    longitude           Float?
    locationAccuracy    Float?
    checkInPhotoCapturedAt String?                    @db.VarChar(19)
    checkInPhotoOffset  String?                       @db.VarChar(6)
    checkOutDueAt       DateTime?                     @db.DateTime(3)
    checkOutAt          DateTime?                     @db.DateTime(3)
    checkOutRecordedAt  DateTime?                     @db.DateTime(3)
    checkOutType        CheckoutType?
    checkOutIdempotencyKey String?                     @unique @db.VarChar(100)
    checkOutFingerprint String?                        @db.Char(64)
    activityDescription String?                        @db.Text
    evidence            Evidence[]
    idempotency         Idempotency?
    source              AttendanceSource             @default(DIRECT)
    missedCheckInClaim  MissedCheckInClaim?

    @@unique([employeeId, workDate])
    @@index([workDate, department])
    @@index([workDate, submittedAt])
    @@index([workDate, source, checkOutAt])
}

model MissedCheckInReviewGrant {
    id         String         @id @default(uuid()) @db.Char(36)
    userId     String         @db.Char(36)
    user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
    department DepartmentCode
    permission String         @default("MISSED_CHECK_IN_CLAIM_REVIEW") @db.VarChar(64)
    createdAt  DateTime       @default(now())

    @@unique([userId, department, permission])
}

model MissedCheckInClaim {
    id                   String         @id @default(uuid()) @db.Char(36)
    employeeId           String         @db.Char(36)
    employee             Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
    workDate              String         @db.Char(10)
    claimedCheckInTime    String         @db.VarChar(5)
    claimedCheckOutTime   String         @db.VarChar(5)
    reason                String         @db.Text
    truthConfirmed        Boolean        @default(false)
    status                MissedCheckInClaimStatus @default(PENDING)
    requestedAt           DateTime       @default(now()) @db.DateTime(3)
    reviewedAt            DateTime?      @db.DateTime(3)
    reviewedByUserId      String?        @db.Char(36)
    reviewer              User?          @relation("MissedCheckInReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
    reviewNote            String?        @db.Text
    version               Int            @default(0)
    idempotencyKey        String         @db.VarChar(100)
    pendingKey            String?        @unique @db.VarChar(64)
    attendanceId          String?        @unique @db.Char(36)
    attendance            Attendance?    @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
    evidence              MissedCheckInClaimEvidence?
    createdAt             DateTime       @default(now())
    updatedAt             DateTime       @updatedAt

    @@unique([employeeId, idempotencyKey])
    @@index([employeeId, workDate, status])
    @@index([status, requestedAt])
}

model MissedCheckInClaimEvidence {
    id          String              @id @default(uuid()) @db.Char(36)
    claimId     String              @unique @db.Char(36)
    claim       MissedCheckInClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
    storageKey  String              @unique @db.Char(36)
    mimeType    String              @db.VarChar(50)
    size        Int
    sha256      String              @db.Char(64)
    recordedAt  DateTime            @default(now()) @db.DateTime(3)
}

model Evidence {
    id            String                 @id @default(uuid()) @db.Char(36)
    attendanceId  String                 @db.Char(36)
    attendance    Attendance             @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
    kind          AttendanceEvidenceKind @default(CHECKIN_WORK_PROOF)
    workProofType WorkProofType?
    storageKey    String                 @unique @db.Char(36)
    mimeType      String                 @db.VarChar(50)
    size          Int
    sha256        String                 @db.Char(64)
    recordedAt    DateTime               @default(now()) @db.DateTime(3)

    @@unique([attendanceId, kind])
}

model Idempotency {
    id           String     @id @default(uuid()) @db.Char(36)
    employeeId   String     @db.Char(36)
    key          String     @db.VarChar(100)
    fingerprint  String     @db.Char(64)
    attendanceId String     @unique @db.Char(36)
    attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Restrict)

    @@unique([employeeId, key])
}

model AuditEvent {
    id         String   @id @default(uuid()) @db.Char(36)
    actorId    String   @db.Char(36)
    employeeId String   @db.Char(36)
    action     String   @db.VarChar(40)
    changes    Json
    createdAt  DateTime @default(now())
}
